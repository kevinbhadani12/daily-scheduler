# Optional. Everything here can also be set in the dashboard (Connections / General settings).
# Copy to .env when running with `python app.py`. Values here override the dashboard.

# PORT=8000
# PUBLIC_URL=https://briefings.example.com   # the address your phone opens (used in links)
# ADMIN_PASSWORD=choose-a-strong-password    # skip the first-time setup page
# COOKIE_SECURE=1                             # set when the app is served over https

# GEMINI_API_KEY=AIza...
# TELEGRAM_BOT_TOKEN=123456789:ABC...
# TELEGRAM_CHAT_ID=123456789
# EMAIL_ADDRESS=you@gmail.com
# EMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# EMAIL_TO=you@gmail.com
